<?xml version="1.0" encoding="utf-8"?>
<!--
  The splash icon. An icon without a background plate is drawn into 288dp with
  only the middle 192dp meant to be used — the same two-thirds the launcher
  mask keeps — so the drop is drawn at the launcher foreground's transform
  exactly, and lands in the same place: no jump in size between the splash and
  the icon the user just tapped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.9"
        android:scaleY="1.9"
        android:translateX="23.6"
        android:translateY="25.5">
        <path
            android:fillColor="@color/accent"
            android:pathData="M16,2.5c5.4,6.2 9.2,11 9.2,15.6A9.2,9.2 0,0 1,16 27.3a9.2,9.2 0,0 1,-9.2 -9.2C6.8,13.5 10.6,8.7 16,2.5Z" />
        <path
            android:pathData="M7.3,18.6c2.2,0 2.2,1.7 4.4,1.7s2.2,-1.7 4.3,-1.7c2.2,0 2.2,1.7 4.4,1.7s2.2,-1.7 4.3,-1.7"
            android:strokeColor="@color/accent_ink"
            android:strokeAlpha="0.55"
            android:strokeWidth="1.5"
            android:strokeLineCap="round" />
    </group>
</vector>
