<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same reasoning as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="fasts.json" />
        <include domain="sharedpref" path="waterline_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="fasts.json" />
        <include domain="sharedpref" path="waterline_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
