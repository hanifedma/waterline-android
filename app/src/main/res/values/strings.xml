    <string name="channel_milestone">Milestones</string>
    <string name="channel_milestone_desc">Ketosis, autophagy, and the moment you reach your goal.</string>
    <string name="channel_reminder">Reminders</string>
    <string name="channel_reminder_desc">A nudge to start a fast when the clock is not running.</string>
</resources>
