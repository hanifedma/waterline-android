<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sync and sign-in. The app is fully usable with neither. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The running fast lives in the notification shade and on the lock
         screen. On Android 13+ that needs the user's permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A fast can run for days, so the clock is a foreground service: it is
         exempt from Doze and from the 6-hour cap that applies to dataSync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Milestone alerts and the "start a fast?" nudge fire on alarms, which
         must still land while the device is dozing. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Bring the clock back after a reboot without waiting for the app to be
         opened; otherwise a fast started last night has no notification. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Offered as a one-tap action in Settings, never requested silently. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lets Settings offer "let milestones through Do Not Disturb". Without
         the grant the toggle is simply shown as unavailable. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:name=".WaterlineApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Waterline">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Waterline.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The fasting clock.

             stopWithTask=false is the whole point: swiping Waterline out of
             recents must not stop a fast that is still running. specialUse is
             the correct type — this is a long-running user-visible stopwatch,
             not a data sync (capped at 6 hours) and not a health service
             (which additionally demands body-sensor permissions it has no use
             for). -->
        <service
            android:name=".notify.TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Tracks an ongoing water fast the user explicitly started, showing elapsed time in an ongoing notification until they end it." />
        </service>

        <!-- Milestone alarms, the idle reminder, and its re-arm after the user
             swipes it away. -->
        <receiver
            android:name=".notify.AlarmReceiver"
            android:exported="false" />

        <!-- Restores the clock and every alarm after a reboot or an update. -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager's own components are merged in from the library. The
             watchdog worker it runs is registered in code. -->

    </application>

</manifest>
